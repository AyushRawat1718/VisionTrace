# Database
DATABASE_URL=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Gemini — must be a vision-capable model, e.g. "gemini-2.5-flash"
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Auth — the single demo admin account. Change these before any real use.
JWT_SECRET="change-this-to-a-long-random-string"
ADMIN_EMAIL="admin@visiontrace.local"
ADMIN_PASSWORD="visiontrace-demo"

# Demo assessment — auto-created on startup if it doesn't exist yet, and
# shown on the landing page's "Try it yourself" section.
DEMO_ASSESSMENT_CODE=""

# CORS — the origin the frontend dashboard runs on
FRONTEND_URL="http://localhost:5173"

# Server
PORT=8000
