generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccessType {
  OPEN
  RESTRICTED
}

model Assessment {
  id          String          @id @default(cuid())
  title        String
  code         String          @unique
  accessType   AccessType      @default(OPEN)
  createdAt    DateTime        @default(now())

  allowedUsers AllowedUser[]
}

model AllowedUser {
  id            String     @id @default(cuid())
  email         String

  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([email, assessmentId])
}