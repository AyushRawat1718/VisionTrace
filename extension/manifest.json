{
  "manifest_version": 3,
  "name": "VisionTrace",
  "version": "1.0",

  "permissions": ["tabs", "activeTab", "storage", "alarms"],

  "host_permissions": ["http://localhost:8000/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VisionTrace"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
