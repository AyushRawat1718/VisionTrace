{
  "manifest_version": 3,
  "name": "VisionTrace",
  "version": "1.0",

  "permissions": ["tabs", "storage", "alarms"],

  "host_permissions": ["https://visiontrace.onrender.com/*", "<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VisionTrace"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
